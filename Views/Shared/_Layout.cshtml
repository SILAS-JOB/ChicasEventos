<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Chicas Eventos</title>
    <script type="importmap"></script>
    <link rel="icon" href="~/favicon.ico" type="image/x-icon"  />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ChicasEventos.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white py-3">
            <div class="container">
                
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <img src="~/img/props/ChicasLogo.png" alt="Chicas Eventos Logo" style="height: 50px;">
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    
                    <ul class="navbar-nav d-lg-flex align-items-center justify-content-center" style="flex: 1;">
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center" asp-controller="Home" asp-action="Index" style="height: 50px;"><b>HOME</b></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center" asp-controller="Home" asp-action="Portifolio" style="height: 50px;"><b>PORTIFÓLIO</b></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center" asp-controller="Home" asp-action="Sobre" style="height: 50px;"><b>SOBRE NÓS</b></a>
                        </li>
                    </ul>

                    <ul class="navbar-nav d-flex align-items-center ms-lg-auto">
                        <li class="nav-item me-3 d-flex align-items-center">
                            <a class="btn btn-outline-primary contact-btn d-flex align-items-center" href="https://wa.me/5591991722306?text=Olá! Gostaria de solicitar um orçamento para meu evento." target="_blank" style="border-color: #A0522D; color: #A0522D; border-radius: 25px; padding: 8px 20px; font-weight: 600; text-decoration: none; transition: all 0.3s ease; height: 40px;">
                                ENTRE EM CONTATO
                            </a>
                        </li>
                        <li class="nav-item d-flex align-items-center">
                            <a class="nav-link cart-icon-container d-flex align-items-center" asp-controller="Pages" asp-action="Carrinho" style="height: 50px;">
                                <img src="https://img.icons8.com/?size=100&id=59997&format=png&color=000000" style="height: 30px;"/>
                                <span id="cart-counter" class="badge bg-danger rounded-pill">0</span>
                            </a>
                        </li>
                    </ul>

                </div>

            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-about">
                    <div class="footer-logo">
                        <img src="~/img/icons/logo/logo rem.png" alt="Chicas Eventos Logo" class="footer-logo-img">
                    </div>
                    <p>Transformamos cada evento em uma experiência exclusiva conduzida com profissionalismo, excelência e dedicação em cada detalhe. 
                    Nosso compromisso é oferecer soluções personalizadas que refletem a identidade de cada cliente garantindo qualidade e resultados memoráveis.</p>
                </div>
                <div class="footer-column">
                    <h4>Serviços</h4>
                    <ul>
                        <li><a href="#">Buffet</a></li>
                        <li><a href="#">Audiovisual</a></li>
                        <li><a href="#">RH</a></li>
                        <li><a href="#">Cerimonial</a></li>
                    </ul>
                </div>
                <div class="footer-column">
                    <h4>Empresa</h4>
                    <ul>
                        <li><a href="#">Sobre</a></li>
                        <li><a href="#">Portfólio</a></li>
                        <li><a href="#">Contato</a></li>
                        <li><a href="#">Faça seu evento</a></li>
                    </ul>
                </div>
                <div class="footer-column">
                    <h4>Conecte-se</h4>
                    <div class="footer-socials">
                        <a href="#" class="social-icon instagram">
                            <img src="~/img/icons/icones/Group.svg" alt="Instagram" style="width: 22px; height: 22px;">
                        </a>
                        <a href="#" class="social-icon linkedin">
                            <img src="~/img/icons/icones/LinkedIn - Original.svg" alt="LinkedIn" style="width: 22px; height: 22px;">
                        </a>
                        <a href="#" class="social-icon facebook">
                            <img src="~/img/icons/icones/Facebook - Original.svg" alt="Facebook" style="width: 22px; height: 22px;">
                        </a>
                        <a href="#" class="social-icon twitter">
                            <img src="~/img/icons/icones/Twitter - Original.svg" alt="Twitter" style="width: 22px; height: 22px;">
                        </a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2025 Chicas Eventos. Todos os direitos reservados. Ketsudsgn & Silas-DEV</p>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/cart.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
