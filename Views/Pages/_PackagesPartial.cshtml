@model List<ChicasEventos.Models.PackageViewModel>

<div class="p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="modal-title">Nossos pacotes</h3>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <p>Cardápios sob medida para cada ocasião...</p>

    <div class="row">
        @foreach(var package in Model)
        {
            <div class="col-md-4">
                <div class="card package-card">
                    <img src="@package.ImagemPrincipal" class="card-img-top" alt="@package.Nome">
                    <div class="card-body">
                        <h5 class="card-title">@package.Nome</h5>
                        <p class="card-text">@package.Descricao</p>
                        <p class="fw-bold">@package.PrecoPorPessoa</p>
                        <button class="btn btn-primary w-100 btn-package-details" data-id="@package.Id">
                            VER DETALHES
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>