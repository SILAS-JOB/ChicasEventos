@model List<ChicasEventos.Models.ServiceViewModel>

@{
    ViewBag.Title = "Buffet ";
}

<link rel="stylesheet" href="~/css/Pages/Services.css" />
<link rel="stylesheet" href="~/css/Partial/ServicePartial.css"/>

<body>
    <main class="container">
        <section class="service-page">
            <p class="section-subtitle">Serviços</p>
            <h1>Buffet</h1>
            <p>Cardápios sob medida para cada ocasião: coquetéis, coffee break, brunch e refeições completas. Clique nos cartões para ver os detalhes.</p>
            <button class="main-cta-button btn-pacotes" data-bs-toggle="modal" data-bs-target="#detailsModal" data-category="Buffet">
            Ver pacotes
            </button>
            <div class="services-grid">
                @foreach (var service in Model)
                {
                    <div class="service-card">
                        <img src="@service.ImagemPrincipalCard" class="card-background" alt="@service.Titulo">
                        <div class="card-overlay"></div>
                        <div class="card-content">
                            <h3>@service.Titulo</h3>
                            <p>@service.DescricaoBreve</p>
                                <button type="button" 
                                        class="btn btn-outline-light btn-detalhes" 
                                        data-bs-toggle="modal" 
                                        data-bs-target="#detailsModal"
                                        data-id="@service.Id">
                                    VER DETALHES
                                </button>
                        </div>
                    </div>
                }
            </div>
            <div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-centered">
                    <div class="modal-content" style="border-radius: 1rem;">
                    
                    <div class="modal-body p-0" id="modalBodyContent">
            </div>
        </div>
      </div>
    </div>
        </section>
    </main>
</body>
<script src="~/js/CardModal.js">
</script>
</html>