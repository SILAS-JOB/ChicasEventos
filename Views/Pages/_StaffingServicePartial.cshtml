@model List<ChicasEventos.Models.StaffingServiceViewModel>

<style>
    .staffing-service-checkbox {
        width: 1.5em; height: 1.5em; border-width: 2px;
        cursor: pointer; vertical-align: middle; margin-top: 0.5em;
    }
</style>

<div class="modal-header">
    <h5 class="modal-title">Adicionar Serviços de Equipe</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <p>Selecione os serviços e a duração desejada para cada um.</p>
    <div class="row">
        <div class="col-md-7">
            <form id="staffing-form">
                @foreach (var service in Model)
                {
                    <div class="form-check mb-3">
                        <input class="form-check-input staffing-service-checkbox" type="checkbox" 
                               id="service_@service.Id" value="@service.Id" data-title="@service.Title">
                        <label class="form-check-label ms-2" for="service_@service.Id">
                            <strong>@service.Title</strong>
                            <small class="d-block text-muted">@service.Description</small>
                        </label>
                        
                        @if (service.PricingOptions.Any())
                        {
                            <select class="form-select form-select-sm mt-2 staffing-duration-select" disabled>
                                <option value="0" data-price="0" data-label="">Selecione a duração</option>
                                @foreach (var option in service.PricingOptions)
                                {
                                    <option value="@option.Id" 
                                            data-price="@option.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" 
                                            data-label="@option.Label">
                                        @option.Label
                                    </option>
                                }
                            </select>
                        }
                    </div>
                }
            </form>
        </div>

        <div class="col-md-5">
            <div class="card p-3 h-100">
                <h6>Resumo da Seleção</h6>
                <hr>
                <div id="summary-items-list" class="flex-grow-1 mb-2">
                    <span class="text-muted small">Nenhum item selecionado</span>
                </div>
                <hr>
                <div class="d-flex justify-content-between align-items-center mt-auto">
                    <strong>Total</strong>
                    <span id="summary-total" class="fs-5 fw-bold text-success">R$ 0,00</span>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">CANCELAR</button>
    <button type="button" id="btn-add-staffing-to-cart" class="btn btn-primary" disabled>ADICIONAR SELEÇÃO</button>
</div>

<script>
    (function() {
        const form = document.getElementById('staffing-form');
        const summaryItemsList = document.getElementById('summary-items-list');
        const summaryTotal = document.getElementById('summary-total');
        const addToCartButton = document.getElementById('btn-add-staffing-to-cart');
        
        // Estrutura para guardar os detalhes dos itens selecionados para o carrinho
        let currentSelectionForCart = []; 

        // Ouve qualquer mudança no formulário
        form.addEventListener('change', function() {
            manageDropdownStates();
            updateSummary();
        });

        // Habilita/Desabilita dropdowns
        function manageDropdownStates() {
             form.querySelectorAll('.staffing-service-checkbox').forEach(checkbox => {
                const select = checkbox.closest('.form-check').querySelector('.staffing-duration-select');
                if (select) {
                    select.disabled = !checkbox.checked;
                    if (!checkbox.checked) {
                        select.selectedIndex = 0;
                    }
                }
            });
        }

        // Atualiza o resumo e o total
        function updateSummary() {
            let total = 0;
            let itemsHtml = '';
            currentSelectionForCart = []; // Limpa a seleção para recalcular
            let allValidSelectionsMade = true; // Assumimos que está tudo ok inicialmente

            const checkedBoxes = form.querySelectorAll('.staffing-service-checkbox:checked');

            checkedBoxes.forEach(box => {
                const title = box.dataset.title;
                const serviceId = parseInt(box.value);
                let itemDescription = title;
                let itemPrice = 0;
                let optionId = 0;
                let isValid = false; // Flag para este item específico

                const select = box.closest('.form-check').querySelector('.staffing-duration-select');
                
                if (select) { // Se tem dropdown
                    if (select.selectedIndex > 0) { // E uma duração foi selecionada
                        const option = select.options[select.selectedIndex];
                        const price = parseFloat(option.dataset.price);
                        optionId = parseInt(option.value);
                        itemPrice = price;
                        itemDescription += ` (${option.dataset.label})`; // Adiciona a duração ex: (2h - R$ 70)
                        isValid = true;
                    } else {
                        // Se tem dropdown mas NENHUMA duração foi selecionada, a seleção GERAL é inválida
                        allValidSelectionsMade = false; 
                    }
                } else { // Se não tem dropdown (preço fixo ou a combinar)
                    // Assumimos que é válido (adaptar se tiver preço fixo no data-price do checkbox)
                    isValid = true; 
                    itemDescription += ` (A combinar)`; 
                }

                if (isValid) {
                     total += itemPrice;
                     itemsHtml += `<div class="d-flex justify-content-between small"><span>${title}</span> <span>${itemPrice > 0 ? itemPrice.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) : 'A combinar'}</span></div>`;
                     // Adiciona o item válido à lista para o carrinho
                     currentSelectionForCart.push({ id: serviceId, type: 'staffing', optionId: optionId }); 
                } else {
                     // Adiciona o item inválido ao resumo visual, mas não ao carrinho/total
                     itemsHtml += `<div class="d-flex justify-content-between small text-warning"><span>${title}</span> <span>Selecione a duração</span></div>`;
                }
            });

            summaryItemsList.innerHTML = itemsHtml || '<span class="text-muted small">Nenhum item selecionado</span>';
            summaryTotal.textContent = total.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
            
            // O botão só habilita se houver itens marcados E todas as durações necessárias foram selecionadas
            addToCartButton.disabled = checkedBoxes.length === 0 || !allValidSelectionsMade; 
        }
        
        // Adiciona a seleção ao carrinho principal
        addToCartButton.addEventListener('click', function() {
            const cartItems = JSON.parse(localStorage.getItem('chicasCart') || '[]');
            let itemsAddedCount = 0;

            currentSelectionForCart.forEach(itemToAdd => {
                // Verificação para evitar duplicatas EXATAS (mesmo serviço, mesma opção)
                const exists = cartItems.some(cartItem => cartItem.id === itemToAdd.id && cartItem.optionId === itemToAdd.optionId && cartItem.type === itemToAdd.type);
                if (!exists) {
                    cartItems.push(itemToAdd);
                    itemsAddedCount++;
                }
            });
            
            localStorage.setItem('chicasCart', JSON.stringify(cartItems));

            if (typeof updateCartCounter === 'function') { updateCartCounter(); }
            alert(`${itemsAddedCount} novo(s) item(ns) adicionado(s) ao orçamento!`);
            
            const modalElement = document.getElementById('detailsModal'); // Assumindo que este é o ID do seu modal container
            const modalInstance = bootstrap.Modal.getInstance(modalElement);
            if (modalInstance) { modalInstance.hide(); }
        });
        
        manageDropdownStates();
        updateSummary();

    })();
</script>