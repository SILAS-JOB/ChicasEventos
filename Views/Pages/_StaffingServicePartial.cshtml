@model List<ChicasEventos.Models.StaffingServiceViewModel>

<style>
    .staffing-service-checkbox {
        width: 1.5em; height: 1.5em; border-width: 2px;
        cursor: pointer; vertical-align: middle; margin-top: 0.5em;
    }
</style>

<div class="modal-header">
    <h5 class="modal-title">Adicionar Serviços de Equipe</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <p>Selecione os serviços e a duração desejada para cada um.</p>
    <div class="row">
        <div class="col-md-7">
            <form id="staffing-form">
                @foreach (var service in Model)
                {
                    <div class="form-check mb-3">
                        <input class="form-check-input staffing-service-checkbox" type="checkbox" 
                               id="service_@service.Id" value="@service.Id" data-title="@service.Title">
                        <label class="form-check-label ms-2" for="service_@service.Id">
                            <strong>@service.Title</strong>
                            <small class="d-block text-muted">@service.Description</small>
                        </label>
                        
                        @if (service.PricingOptions.Any())
                        {
                            <select class="form-select form-select-sm mt-2 staffing-duration-select" disabled>
                                <option value="0" data-price="0" data-label="">Selecione a duração</option>
                                @foreach (var option in service.PricingOptions)
                                {
                                    <option value="@option.Id" 
                                            data-price="@option.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" 
                                            data-label="@option.Label">
                                        @option.Label
                                    </option>
                                }
                            </select>
                        }
                    </div>
                }
            </form>
        </div>

        <div class="col-md-5">
            <div class="card p-3 h-100">
                <h6>Resumo da Seleção</h6>
                <hr>
                <div id="summary-items-list" class="flex-grow-1 mb-2">
                    <span class="text-muted small">Nenhum item selecionado</span>
                </div>
                <hr>
                <div class="d-flex justify-content-between align-items-center mt-auto">
                    <strong>Total</strong>
                    <span id="summary-total" class="fs-5 fw-bold text-success">R$ 0,00</span>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">CANCELAR</button>
    <button type="button" id="btn-add-staffing-to-cart" class="btn btn-primary" disabled>ADICIONAR SELEÇÃO</button>
</div>
<script src="~/js/CardModal.js"></script>