@using ChicasEventos.Models
@model List<object>

<h4>Itens selecionados</h4>

@foreach (var item in Model)
{
    if (item is ServiceViewModel service)
    {
        <div class="card mb-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <input type="checkbox" checked class="form-check-input me-3">
                    <strong>@service.Titulo</strong> (@service.Category)
                </div>
                <span>-- valor --</span>
            </div>
        </div>
    }
    else if (item is PackageViewModel package)
    {
        <div class="card mb-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                 <div>
                    <input type="checkbox" checked class="form-check-input me-3">
                    <strong>@package.Nome</strong> (@package.PrecoPorPessoa)
                </div>
                <span>-- valor --</span>
            </div>
        </div>
    }
    var itemType = item.GetType();
    if (itemType.Name.Contains("AnonymousType"))
    {
        <div class="card mb-3">
            <div class="card-body">
                <strong>@itemType.GetProperty("Title").GetValue(item)</strong>
                <div class="text-muted small">@itemType.GetProperty("Label").GetValue(item)</div>
                <div class="fw-bold">@(((decimal)itemType.GetProperty("Price").GetValue(item)).ToString("C"))</div>
            </div>
        </div>
    }
}