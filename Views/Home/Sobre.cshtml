@{
    ViewBag.Title = "Sobre Nós ";
}

<link  rel="stylesheet" href="~/css/Home/sobre.css" />

<body>
    <main>
        <section class="hero container">
            <p class="section-subtitle">CHICAS EVENTOS</p>
            <h1>Transformamos encontros em memórias inesquecíveis</h1>
            <p>Conheça a nossa história, os valores que nos guiam e o que nos torna a escolha ideal para o seu próximo evento.</p>
        </section>

        <section class="container">
            <div class="about-story">
                <div class="about-story-text">
                    <h2>Como tudo começou</h2>
                    <p>Começamos pequenos: uma cozinha emprestada, um cardápio curtinho e uma vontade enorme de atender bem. Os primeiros eventos foram para amigos e negócios locais. O boca-a-boca fez o resto – e seguimos crescendo.</p>
                    <p>Hoje atendemos empresas, casamentos e celebrações diversas. Mantivemos o que nos trouxe até aqui: capricho, transparência e experiência. Cada projeto é único – por isso adaptamos cardápio, operação e linguagem ao seu público.</p>
                </div>
                <div class="about-story-images">
                    <img src="~/img/fotos/Início com os jogos de mesa e a kombi.jpg" alt="Início com os jogos de mesa e a kombi">
                    <img src="~/img/fotos/Snapinsta.app_448202003_18032547605056179_3659835882246595_n_1080.jpg" alt="História da empresa">
                </div>
            </div>
        </section>
        
        <section class="guiding-principles container">
            <p class="section-subtitle">O que nos move</p>
            <h2>O que guia cada projeto</h2>
            <p>Trabalhamos com base em pilares que garantem a excelência e o sucesso de cada celebração.</p>
            <div class="principles-grid">
                <div class="principle-card">
                    <i class="fas fa-heart"></i>
                    <h3>Cuidado</h3>
                    <p>Atenção aos mínimos detalhes para que tudo saia perfeito e supere as expectativas.</p>
                </div>
                <div class="principle-card">
                    <i class="fas fa-bolt"></i>
                    <h3>Agilidade</h3>
                    <p>Processos otimizados e uma equipe proativa para garantir tranquilidade e eficiência.</p>
                </div>
                <div class="principle-card">
                    <i class="fas fa-palette"></i>
                    <h3>Personalização</h3>
                    <p>Seu evento com a sua identidade. Criamos experiências únicas e sob medida.</p>
                </div>
            </div>
        </section>

        <section class="cta-section">
            <div class="container">
                <h2>Vamos planejar seu próximo evento?</h2>
                <p>Leva apenas 2 minutos para enviar o briefing. Respondemos rapidinho com uma proposta personalizada!</p>
                <a href="#" class="cta-button">Fazer orçamento +</a>
            </div>
        </section>

        <section class="contact-section text-center">
            <div class="container">
                <p class="section-subtitle">CONTATO</p>
                <h2>Fale com a gente</h2>
                <p>Escolha o seu canal de atendimento preferido.</p>
                <div class="contact-grid">
                    <div class="contact-card">
                        <i class="fab fa-whatsapp"></i>
                        <h3>WhatsApp</h3>
                        <p>+55 91 9 9172-2306</p>
                        <a href="#" class="contact-button btn-whatsapp">Conversar agora</a>
                    </div>
                    <div class="contact-card">
                        <i class="far fa-envelope"></i>
                        <h3>E-mail</h3>
                        <p>contato@chicaseventos.com.br</p>
                        <a href="#" class="contact-button btn-email">Enviar e-mail</a>
                    </div>
                    <div class="contact-card">
                        <i class="fab fa-instagram"></i>
                        <h3>Instagram</h3>
                        <p>@@chicascafe</p>
                        <a href="#" class="contact-button btn-instagram">Ver perfil</a>
                    </div>
                </div>
            </div>
        </section>
        
        <section class="container">
            <div class="address-section">
                <div class="container">
                    <div class="address-info">
                        <i class="fas fa-map-marker-alt"></i>
                        <h3>Nosso endereço</h3>
                        <p>Rua Exemplo Fictício, 123<br>Bairro, Cidade - UF<br>CEP: 12345-678</p>
                        <div class="address-actions">
                            <a href="https://www.google.com/maps/search/São+Paulo,+SP" target="_blank" class="map-link">
                                Ver no Google Maps
                            </a>
                        </div>
                    </div>
                    <div class="address-map">
                        <iframe 
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3657.1975!2d-46.6333!3d-23.5505!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMjPCsDMzJzAxLjgiUyA0NsKwMzcnNTkuOSJX!5e0!3m2!1spt-BR!2sbr!4v1234567890123!5m2!1spt-BR!2sbr"
                            class="google-map-embed"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                    </div>
                </div>
            </div>
        </section>
    </main>
</body>
</html>