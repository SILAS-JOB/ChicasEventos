@{
    ViewBag.Title = "Sejam Bem Vindos!";
}


<link rel="stylesheet" href="~/css/Home/index.css" />

<main>
        <section class="hero container">
            <div class="hero-text">
                <h1>Seu evento corporativo, impecável do início ao fim</h1>
                <p>Nossa equipe cuida de todos os detalhes para que sua única preocupação seja aproveitar cada momento.</p>
            </div>
            <div class="hero-image">
                <img src="https://images.unsplash.com/photo-1542744173-8e7e53415bb0?q=80&w=2070&auto=format&fit=crop" alt="Pessoas em um evento corporativo">
            </div>
        </section>

        <section class="services container">
            <h2>Nossos serviços</h2>
            <p>Acreditamos que cada evento é único. Por isso, oferecemos soluções completas e flexíveis que se adaptam às suas necessidades, do planejamento à execução.</p>
            <div class="service-cards">
                <div class="service-card">
                    <img src="https://images.unsplash.com/photo-1522204523234-8729aa6e3d54?q=80&w=2070&auto=format&fit=crop" alt="Buffet completo">
                    <h3>Buffet completo</h3>
                </div>
                <div class="service-card">
                    <img src="https://images.unsplash.com/photo-1511795409834-ef04bbd51622?q=80&w=2070&auto=format&fit=crop" alt="Equipe profissional">
                    <h3>Captação Audiovisual</h3>
                </div>
                <div class="service-card">
                    <img src="https://images.unsplash.com/photo-1556761175-b413da4b248a?q=80&w=1974&auto=format&fit=crop" alt="Bebidas">
                    <h3>Bebidas</h3>
                </div>
                <div class="service-card">
                    <img src="https://images.unsplash.com/photo-1587825140708-dfaf72ae4b04?q=80&w=2070&auto=format&fit=crop" alt="Organização">
                    <h3>Organização Completa</h3>
                </div>
            </div>
        </section>
        
        <section class="why-us">
            <div class="container">
                <p class="section-subtitle">Nossos Diferenciais</p>
                <h2>Por que escolher a Chicas Eventos?</h2>
                <div class="features-grid">
                    <div class="feature-card">
                        <i class="fa-solid fa-lightbulb"></i>
                        <h3>Inovação completa</h3>
                    </div>
                    <div class="feature-card">
                        <i class="fa-solid fa-bolt"></i>
                        <h3>Agilidade garantida</h3>
                    </div>
                    <div class="feature-card">
                        <i class="fa-solid fa-gem"></i>
                        <h3>Beleza funcional</h3>
                    </div>
                    <div class="feature-card">
                        <i class="fa-solid fa-handshake-angle"></i>
                        <h3>Responsabilidade social</h3>
                    </div>
                    <div class="feature-card">
                        <i class="fa-solid fa-map-marker-alt"></i>
                        <h3>Identidade regional</h3>
                    </div>
                    <div class="feature-card">
                        <i class="fa-solid fa-headset"></i>
                        <h3>Acompanhamento total</h3>
                    </div>
                </div>
            </div>
        </section>

        <section class="portfolio container">
            <h2>Portfólio</h2>
            <p>Uma seleção dos nossos melhores projetos para você se inspirar e conhecer a qualidade do nosso trabalho.</p>
            <div class="portfolio-filters">
                <button class="active">Ver todos</button>
                <button>Corporativo</button>
                <button>Social</button>
                <button>Casamento</button>
                <button>Debutante</button>
                <button>Temático</button>
            </div>
            <div class="portfolio-gallery">
                <img src="https://images.unsplash.com/photo-1511578314322-379afb476865?q=80&w=2070&auto=format&fit=crop" alt="Galeria imagem 1">
                <img src="https://images.unsplash.com/photo-1519167758481-83f550bb49b3?q=80&w=2070&auto=format&fit=crop" alt="Galeria imagem 2">
                <img src="https://images.unsplash.com/photo-1505373877841-8d25f7d46678?q=80&w=2012&auto=format&fit=crop" alt="Galeria imagem 3">
                <img src="https://images.unsplash.com/photo-1485178654271-8c8368151a8f?q=80&w=2070&auto=format&fit=crop" alt="Galeria imagem 4">
                <img src="https://images.unsplash.com/photo-1516048015947-89335ba41262?q=80&w=2070&auto=format&fit=crop" alt="Galeria imagem 5">
                <img src="https://images.unsplash.com/photo-1540555233512-2c6deaa22c23?q=80&w=2070&auto=format&fit=crop" alt="Galeria imagem 6">
                <img src="https://images.unsplash.com/photo-1561494265-b143b7891781?q=80&w=1974&auto=format&fit=crop" alt="Galeria imagem 7">
                <img src="https://images.unsplash.com/photo-1530103862676-de8c9debad1d?q=80&w=2070&auto=format&fit=crop" alt="Galeria imagem 8">
            </div>
        </section>
    </main>